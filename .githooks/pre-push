#!/usr/bin/env bash
# push の前に、ノートの tex を変えていれば scripts/check_note.sh を走らせ、誤りがあれば push を止める
# （振り返り 2026-11-13 の T-01。「付録 付録C」の重なりが 11/09 と 11/13 に再発したので、README の手順から git の hook に上げた）。
# 有効にする：git config core.hooksPath .githooks（クローンごとに一度。README の「動かす」）
# 検査するのは手元の作業ツリーのノート。push するコミットと作業ツリーが違うときは、先にそろえる。
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
changed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # ブランチを消す push
  if [ "$remote_sha" = "$zero" ]; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  else
    base="$remote_sha"
  fi
  if [ -z "$base" ] || git diff --name-only "$base" "$local_sha" | grep -q '^notes/.*\.tex$'; then
    changed=1
  fi
done
[ "$changed" = 0 ] && exit 0
echo "pre-push：ノートの tex が変わっているので scripts/check_note.sh を走らせる" >&2
if ! "$root/scripts/check_note.sh" >&2; then
  echo "pre-push：ノートの検査に通らなかったので push を止めた（直してからもう一度 push する）" >&2
  exit 1
fi
